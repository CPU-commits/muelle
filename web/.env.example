# Overrides por máquina. Todo lo que empieza con VITE_ entra al bundle: nada de secretos.
# A dónde proxea `pnpm dev` las llamadas a /api (por defecto, config/local.json).
MUELLE_BACKEND_URL=http://127.0.0.1:18080
# 1 para levantar MSW en el navegador (es lo que hace `pnpm dev:mock`).
VITE_USE_MOCKS=0
