{
	"name": "muelle-panel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"codegen": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/shared/ui/i18n/paraglide --emit-ts-declarations --strategy localStorage baseLocale",
		"prepare": "pnpm codegen || echo \"\"",
		"dev": "vite dev",
		"dev:mock": "VITE_USE_MOCKS=1 vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "pnpm codegen && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm codegen && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"verify": "pnpm lint && pnpm check && pnpm test",
		"clean": "rm -rf build .svelte-kit src/shared/ui/i18n/paraglide test-results"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.10.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"@vanilla-extract/vite-plugin": "^5.2.0",
		"@vitest/browser-playwright": "^4.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"msw": "^2.15.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.1.48",
		"@vanilla-extract/css": "^1.19.0",
		"codemirror": "^6.0.2",
		"qrcode": "^1.5.4",
		"zod": "^4.6.2"
	},
	"packageManager": "pnpm@11.1.2",
	"description": "Panel web de muelle: SPA Svelte + SvelteKit con clean architecture en 3 capas (domain / data / ui), embebida en el binario de Go.",
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
