{
  "admin": {
    "listen": "unix//run/caddy-admin/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "muelle": {
          "listen": [
            ":443"
          ],
          "trusted_proxies": {
            "source": "static",
            "ranges": [
              "173.245.48.0/20",
              "103.21.244.0/22",
              "103.22.200.0/22",
              "103.31.4.0/22",
              "141.101.64.0/18",
              "108.162.192.0/18",
              "190.93.240.0/20",
              "188.114.96.0/20",
              "197.234.240.0/22",
              "198.41.128.0/17",
              "162.158.0.0/15",
              "104.16.0.0/13",
              "104.24.0.0/14",
              "172.64.0.0/13",
              "131.0.72.0/22",
              "2400:cb00::/32",
              "2606:4700::/32",
              "2803:f800::/32",
              "2405:b500::/32",
              "2405:8100::/32",
              "2a06:98c0::/29",
              "2c0f:f248::/32"
            ]
          },
          "client_ip_headers": [
            "CF-Connecting-IP",
            "X-Forwarded-For"
          ],
          "trusted_proxies_strict": 1,
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "panel.auditfy.cl"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "not": [
                            {
                              "client_ip": {
                                "ranges": [
                                  "203.0.113.0/24"
                                ]
                              }
                            }
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 403
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "muelle_muelle:8080"
                            }
                          ],
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.vars.client_ip}"
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "api.auditfy.cl"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "auditfy_staging_api_api:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "grafana.ejemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "auditfy_staging_infra_grafana:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "web.auditfy.cl"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "auditfy_production_web_web:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "api.auditfy.cl",
              "web.auditfy.cl"
            ],
            "issuers": [
              {
                "module": "internal"
              }
            ]
          },
          {
            "subjects": [
              "grafana.ejemplo.com",
              "panel.auditfy.cl"
            ],
            "issuers": [
              {
                "module": "internal"
              }
            ]
          }
        ]
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  }
}
