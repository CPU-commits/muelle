{
  "kind": "service",
  "slug": "pg",
  "spec": {
    "image": "postgres:17",
    "port": 5432,
    "replicas": 1,
    "command": [],
    "healthcheck": {
      "type": "command",
      "command": [
        "pg_isready",
        "-U",
        "app"
      ],
      "interval_s": 10,
      "timeout_s": 5,
      "retries": 3,
      "start_period_s": 20
    },
    "volumes": [
      {
        "name": "data",
        "mount": "/var/lib/postgresql/data"
      },
      {
        "name": "backups",
        "mount": "/backups"
      }
    ],
    "resources": {
      "memory_mb": 1024
    }
  },
  "env": {
    "POSTGRES_PASSWORD": "s3cr3t-pg"
  },
  "images": {
    "pg": "postgres:17@sha256:5e3c1d0b8f211111111111111111111111111111111111111111111111111111"
  },
  "storage_node_id": "node-1"
}
