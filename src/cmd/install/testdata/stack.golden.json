{
  "services": {
    "muelle": {
      "image": "ghcr.io/cpu-commits/muelle:v0.1.0",
      "environment": {
        "MUELLE_DATA_DIR": "/data",
        "MUELLE_INIT_ACME_EMAIL": "tu@correo.cl",
        "MUELLE_INIT_CADDY_IMAGE": "ghcr.io/cpu-commits/muelle-caddy:v0.1.0",
        "MUELLE_INIT_PROXY_HTTPS_PORT": "443",
        "MUELLE_INIT_PROXY_HTTP_PORT": "80",
        "MUELLE_INIT_PUBLIC_IP": "203.0.113.24",
        "MUELLE_INIT_PUBLIC_IPV6": "2001:db8::24",
        "MUELLE_LISTEN": ":8080",
        "MUELLE_MASTER_KEY_FILE": "/run/secrets/muelle_master_key",
        "MUELLE_PANEL_DOMAIN": "panel.tudominio.cl"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock"
        },
        {
          "type": "volume",
          "source": "data",
          "target": "/data"
        },
        {
          "type": "volume",
          "source": "caddy_admin",
          "target": "/run/caddy-admin"
        }
      ],
      "secrets": [
        {
          "source": "master_key",
          "target": "muelle_master_key"
        }
      ],
      "networks": [
        "panel"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.role == manager",
            "node.id == node-1"
          ]
        },
        "update_config": {
          "order": "stop-first",
          "failure_action": "rollback",
          "monitor": "30s"
        },
        "rollback_config": {
          "order": "stop-first"
        }
      }
    }
  },
  "volumes": {
    "caddy_admin": {
      "name": "muelle_caddy_admin"
    },
    "data": {
      "name": "muelle_data"
    }
  },
  "secrets": {
    "master_key": {
      "external": true,
      "name": "muelle_master_key"
    }
  },
  "networks": {
    "panel": {
      "external": true,
      "name": "muelle_panel"
    }
  }
}
